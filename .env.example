CUSTOMER_OPS_DATABASE_URL=sqlite:///./customer_ops.db
# One of: gemini, groq, huggingface
CUSTOMER_OPS_LLM_PROVIDER=gemini
CUSTOMER_OPS_GEMINI_API_KEY=
CUSTOMER_OPS_GEMINI_MODEL=gemini-2.5-flash
CUSTOMER_OPS_GROQ_API_KEY=
CUSTOMER_OPS_GROQ_MODEL=llama-3.3-70b-versatile
# Local model: a Hugging Face hub ID or a local directory. No API key is needed.
CUSTOMER_OPS_HUGGINGFACE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
CUSTOMER_OPS_EMBEDDING_MODEL=all-MiniLM-L6-v2
